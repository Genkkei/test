      "label": "FAQ",
      "title": "Before the film",
      "items": [
        {
          "q": "Are films dubbed?",
          "a": "No, they play in the original language with Russian subtitles. Sunday morning cartoons are dubbed."
        },
        {
          "q": "Can I return a ticket?",
          "a": "Yes, up to two hours before the show, at the box office or via Telegram."
        },
        {
          "q": "Is there popcorn?",
          "a": "No. The foyer serves coffee, tea and pastries before and after the film."
        },
        {
          "q": "What is the film club?",
          "a": "On Thursdays we stay after the evening show and spend half an hour discussing the film with a critic. Your ticket gets you in."
        },
        {
          "q": "Can I hire a screen?",
          "a": "Yes, the 48-seat screen is available for private screenings and presentations from 1,500,000 sum for two hours."
        }
      ]
