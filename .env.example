# Публичный адрес конструктора: из него строятся canonical, sitemap и OG.
SITE_URL=http://localhost:3000
# Пароль админки. Без него в продакшене админка закрыта; в dev — пароль «admin».
ADMIN_PASSWORD=
# Секрет подписи сессии (по умолчанию выводится из пароля).
ADMIN_SECRET=
# Куда админка пишет правки (по умолчанию ./data). Исходные сайты лежат в content/sites.
DATA_DIR=
