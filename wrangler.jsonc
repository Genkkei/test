{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Конструктор Atlas: все сайты и их админки. Сайты открываются на своих адресах
  // через воркеры-маршрутизаторы (workers/router), здесь — atlas.genkai.workers.dev/admin
  // для владельца конструктора.
  "name": "atlas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "atlas", "database_id": "aa4254ea-ab76-4551-99b6-7765ab9b4560", "migrations_dir": "d1/migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "atlas-media" }],
  "vars": { "ATLAS_STORE": "d1", "ATLAS_URL": "https://atlas.genkai.workers.dev", "SITE_URL": "https://atlas.genkai.workers.dev" },
  "observability": { "enabled": true }
  // Секреты: ADMIN_PASSWORD (вход владельца конструктора), ADMIN_SECRET (подпись кук и вебхуков) —
  // `npx wrangler secret put`, в репозиторий не попадают.
}
